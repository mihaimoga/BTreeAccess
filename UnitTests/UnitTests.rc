// Texts such as the ones CFileException::GetErrorMessage formats are loaded from
// this string table; without it MFC fires an ASSERT whenever a file cannot be opened.
//

#define _AFX_NO_SPLITTER_RESOURCES
#define _AFX_NO_OLE_RESOURCES
#define _AFX_NO_TRACKER_RESOURCES
#define _AFX_NO_PROPERTY_RESOURCES
