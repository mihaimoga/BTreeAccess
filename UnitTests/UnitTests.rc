#include "afxres.h"

/////////////////////////////////////////////////////////////////////////////
// English (United States) resources

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Version
//
// The values are fixed on purpose: CVersionInfoTests reads them back through CVersionInfo.
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,3,4
 PRODUCTVERSION 5,6,7,8
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE | VS_FF_PRIVATEBUILD
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "Comments", "Fixture comments"
			VALUE "CompanyName", "BTreeAccess Test Company"
			VALUE "FileDescription", "BTreeAccess unit test fixture"
			VALUE "FileVersion", "1.2.3.4"
			VALUE "InternalName", "UnitTests.dll"
			VALUE "LegalCopyright", "Copyright (C) 2014-2026 Stefan-Mihai MOGA"
			VALUE "LegalTrademarks", "Fixture trademark"
			VALUE "OriginalFilename", "UnitTests.dll"
			VALUE "PrivateBuild", "Fixture private build"
			VALUE "ProductName", "BTreeAccess Unit Tests"
			VALUE "ProductVersion", "5.6.7.8"
			VALUE "SpecialBuild", "Fixture special build"
		END
		BLOCK "040704b0"
		BEGIN
			VALUE "CompanyName", "BTreeAccess Testfirma"
			VALUE "FileDescription", "BTreeAccess Testbeschreibung"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200, 0x407, 1200
	END
END

/////////////////////////////////////////////////////////////////////////////
//
// Standard MFC resources
